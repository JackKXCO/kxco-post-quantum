{
  "name": "kxco-post-quantum",
  "version": "1.7.1",
  "description": "ML-DSA-65, ML-KEM-768 and SLH-DSA-SHA2-192s with key fingerprinting. OpenSSL 3.5 primitives on Node 24+, JavaScript elsewhere. 2,103 NIST ACVP vectors: 1,793 passed, 0 failed, 310 skipped. 225 interop checks, 0 failed. Reproducible builds and provenance.",
  "keywords": [
    "post-quantum",
    "pqc",
    "ml-dsa",
    "ml-kem",
    "slh-dsa",
    "sphincs",
    "dilithium",
    "kyber",
    "nist",
    "fips-203",
    "fips-204",
    "fips-205",
    "webhook-signing",
    "quantum-resistant",
    "armature",
    "key-derivation",
    "hkdf",
    "deterministic-keys",
    "fingerprint",
    "replay-protection",
    "hybrid-signing",
    "non-repudiation",
    "ml-dsa-87",
    "ml-kem-1024",
    "category-5"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "funding": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightsbridgeAIQ/kxco-post-quantum.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-post-quantum/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "imports": {
    "#native": {
      "node": "./src/_native.node.js",
      "default": "./src/_native.stub.js"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./ml-dsa": {
      "types": "./src/ml-dsa.d.ts",
      "import": "./src/ml-dsa.js"
    },
    "./ml-dsa-87": {
      "types": "./src/ml-dsa-87.d.ts",
      "import": "./src/ml-dsa-87.js"
    },
    "./ml-kem": {
      "types": "./src/ml-kem.d.ts",
      "import": "./src/ml-kem.js"
    },
    "./ml-kem-1024": {
      "types": "./src/ml-kem-1024.d.ts",
      "import": "./src/ml-kem-1024.js"
    },
    "./slh-dsa": {
      "types": "./src/slh-dsa.d.ts",
      "import": "./src/slh-dsa.js"
    },
    "./derive": {
      "types": "./src/derive.d.ts",
      "import": "./src/derive.js"
    },
    "./webhook": {
      "types": "./src/webhook.d.ts",
      "import": "./src/webhook.js"
    },
    "./kid": {
      "types": "./src/kid.d.ts",
      "import": "./src/kid.js"
    },
    "./seed": {
      "types": "./src/seed.d.ts",
      "import": "./src/seed.js"
    },
    "./jws": {
      "types": "./src/jws.d.ts",
      "import": "./src/jws.js"
    },
    "./backend": {
      "types": "./src/backend.d.ts",
      "import": "./src/backend.js"
    }
  },
  "files": [
    "AGILITY.md",
    "BENCHMARKS.md",
    "BOUNDARY.md",
    "CHANGELOG.md",
    "CONFORMANCE.md",
    "DEPENDENCIES.md",
    "LICENCE-PRODUCT.md",
    "LICENSE",
    "LIFECYCLE.md",
    "MIGRATION.md",
    "README.md",
    "SECURITY.md",
    "THREAT-MODEL.md",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.0"
  },
  "scripts": {
    "fuzz": "node fuzz/fuzz.mjs",
    "test": "node --test test/basic.test.js && node --test test/backend.test.js && node --test test/context.test.js && node --test test/category5.test.js && node --test test/edge-cases.test.js && node --test test/seed.test.js && node --test test/browser-smoke.test.js && node test/run-vectors.js",
    "test:vectors": "node test/run-vectors.js",
    "generate:vectors": "node test/generate-vectors.js > test/vectors.json",
    "bench": "node bench/bench.js",
    "conformance:fetch": "node conformance/fetch-vectors.mjs",
    "conformance:acvp": "node conformance/run-acvp.mjs --json conformance/results/acvp.json",
    "conformance:interop": "node conformance/interop/run-interop.mjs --json conformance/results/interop.json",
    "conformance:protocol": "node conformance/protocol/run-protocol.mjs --json conformance/results/protocol.json",
    "audit:deps": "node audit/run-audit.mjs --json audit/results/dependencies.json",
    "sbom": "npm sbom --sbom-format cyclonedx --sbom-type library",
    "bench:timing": "node --expose-gc bench/timing.mjs --iterations 20000 --json bench/results/timing.json",
    "bench:primitives": "node --expose-gc bench/primitives.mjs --iterations 100 --json bench/results/primitives.json",
    "evidence": "node scripts/build-evidence.mjs",
    "evidence:full": "node scripts/build-evidence.mjs --full"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
